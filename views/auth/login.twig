{% extends "models/base.twig" %}
{% block pageName %}Login{% endblock %}

{% block headerGoodies %}
<link rel="stylesheet" href="/assets/authpages.css">
{% endblock %}

{% block body %}

<div class="div-center center">
    <div class="item-group">
        <div class="item-container">
            <div style="display: flex;  flex-direction: column;" class="verticalLine">
                <div id="loginthing" >
                    <h1 style="margin-bottom: 0.25rem;">Login</h1>
                    <p>
                        <b>the watr files</b>
                        <br>
                        so basically like you <br>
                        know when like the centipedes
                        <br>🐛
                        <br><br>
                        <i><b>- sword 2026</b></i>
                    </p>
                </div>
            </div>
            </div>
            <div id="loginForm">
                <div id="error-area">
                    <div style="display: none;" class="danger" id="dangermsg">
                        An error occured
                    </div>
                </div>
                <br>
                <form id="authForm">
                    <input type="text" autocomplete="username" name="username" placeholder="username" id="username"><br>
                    <input type="password" name="password" placeholder="password" id="password" autocomplete="current-password"><br><br>
                    <button type="submit" class="button" id="loginButton">Login</button>
                </form>
                <p class="muted">No account? <a href="/auth/register">Sign up</a></p>
            </div>
        </div>
    </div>
</div>

<script>
    let usernameInput = $("#username");
    let passwordInput = $("#password");
    let submitBtn = $("#loginButton");
    let errorMsg = $("#dangermsg");

    $("#authForm").on("submit", function (e) {
        e.preventDefault();
        login();
    });

    function login() {
        $.post("/api/v1/auth/login", {
            username: usernameInput.val(),
            password: passwordInput.val()
        }).fail(onError).done(didHappen);
    }

    function didHappen(data){
        if(data.status == "Okay"){
            errorMsg.css("display", "none");
            window.location.href = "/home";
        } else {
            errorMsg.text(data.message);
            errorMsg.css("display", "block");
        }
    }

    function onError() {
        errorMsg.text("An error occured.");
        errorMsg.css("display", "block");
    }
</script>

{% endblock %}
