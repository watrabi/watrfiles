{% extends "models/base.twig" %}
{% block pageName %}Upload{% endblock %}
{% block body %}
    <div class="page narrow">
        <h1>Upload a file</h1>
        <p class="muted">Images, videos and audio up to {{ maxSize|filesize }}.</p>

        <div style="display: none;" class="danger alert" id="dangermsg"></div>

        <form id="uploadForm">
            <label class="dropzone" id="dropzone">
                <input type="file" name="file" id="file" accept="image/*,video/*,audio/*">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span id="dropzone-text">Drop a file here or click to pick one</span>
            </label>

            <label class="field-label" for="title">Title</label>
            <input type="text" name="title" id="title" maxlength="100" placeholder="leave empty to use the file name">

            <label class="checkbox">
                <input type="checkbox" id="public" checked>
                Show this on the public files page
            </label>

            <div class="progress" id="progress" style="display: none;"><div class="progress-bar" id="progress-bar"></div></div>

            <button type="submit" class="button" id="uploadButton"><i class="fa-solid fa-upload"></i> Upload</button>
        </form>
    </div>

<script>
    const maxSize = {{ maxSize }};
    let fileInput = $("#file");
    let errorMsg = $("#dangermsg");
    let uploadButton = $("#uploadButton");
    let dropzone = $("#dropzone");

    function showError(message) {
        errorMsg.text(message);
        errorMsg.css("display", "block");
    }

    fileInput.on("change", function () {
        let file = this.files[0];
        $("#dropzone-text").text(file ? file.name : "Drop a file here or click to pick one");
        dropzone.toggleClass("has-file", !!file);
    });

    dropzone.on("dragover", function (e) {
        e.preventDefault();
        dropzone.addClass("dragging");
    }).on("dragleave drop", function () {
        dropzone.removeClass("dragging");
    }).on("drop", function (e) {
        e.preventDefault();
        fileInput[0].files = e.originalEvent.dataTransfer.files;
        fileInput.trigger("change");
    });

    $("#uploadForm").on("submit", function (e) {
        e.preventDefault();
        errorMsg.css("display", "none");

        let file = fileInput[0].files[0];

        if (!file) {
            showError("Pick a file to upload first.");
            return;
        }

        if (file.size > maxSize) {
            showError("That file is too big.");
            return;
        }

        let data = new FormData();
        data.append("file", file);
        data.append("title", $("#title").val());
        data.append("public", $("#public").is(":checked") ? "1" : "0");

        uploadButton.prop("disabled", true);
        $("#progress").css("display", "block");

        $.ajax({
            url: "/api/v1/files/upload",
            type: "POST",
            data: data,
            processData: false,
            contentType: false,
            xhr: function () {
                let xhr = new XMLHttpRequest();
                xhr.upload.addEventListener("progress", function (e) {
                    if (e.lengthComputable) {
                        $("#progress-bar").css("width", (e.loaded / e.total * 100) + "%");
                    }
                });
                return xhr;
            }
        }).done(function (data) {
            if (data.status == "Okay") {
                window.location.href = data.url;
            } else {
                showError(data.message);
            }
        }).fail(function () {
            showError("An error occured.");
        }).always(function () {
            uploadButton.prop("disabled", false);
            $("#progress").css("display", "none");
            $("#progress-bar").css("width", "0");
        });
    });
</script>
{% endblock %}
