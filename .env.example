# Generic Stuff
APP_NAME="p1gold golding gold"
APP_DESC="im golding"
APP_ENV=local
APP_DEBUG=true

# Encryption
ENCRYPTION_KEY=""

# Cookies
Domain="example.com" # please just do domain.tld (not subdomain.domain.tld)
CookieName="p1goldcookie"
AuthCookieName="files_auth" # cookie that keeps people logged in

# Uploads
MAX_UPLOAD_MB=100 # also raise upload_max_filesize and post_max_size in php.ini

# Storage (R2)
# leave R2_BUCKET empty to keep files in storage/files instead
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_KEY_ID=""
R2_SECRET=""

# Maintenance Toggles
MAINTENANCE=false
ACTUAL_MAINTENANCE=false

# Database
DB_HOST=""
DB_NAME=""
DB_USER=""
DB_PASS=""
